<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="OpenFlipClock"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppSettings">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppMain"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:label="OpenFlipClock Settings" />
        <activity android:name=".WallhavenActivity" android:label="Wallhaven" />
    </application>
</manifest>
